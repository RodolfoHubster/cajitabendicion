# Base de PRUEBAS: un segundo proyecto de Supabase, nunca el real.
# Copia este archivo a .env.pruebas (ese no se sube al repo) y llenalo AHI.
# Este archivo SI se sube: aqui no van datos, solo los nombres.
# Instrucciones completas: docs/base-de-pruebas.md

# Supabase > Project Settings > API, del proyecto de PRUEBAS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pinta la franja amarilla "Base de pruebas" en la app. No lo quites.
VITE_ENTORNO=pruebas

# Un usuario admin de la base de pruebas, para los scripts de scripts/.
PRUEBA_EMAIL=
PRUEBA_PASSWORD=

# Opcional: cada llamada a la base espera estos milisegundos, para ver los
# esqueletos de carga. Solo funciona con la base de pruebas (maximo 5000).
# VITE_RETRASO_MS=1000
